  "project": { "repo": "tjmtic/ColorMatcher-CoreLib" },
  "releaseBranch": "main",
  "mergeBranch": "develop",
  "autoMerge": true,
  "sections": [
    {
      "id": "core",
      "label": "ColorMatcher core (color science, palettes, matching)",
      "moduleDir": "core-lib/src",
      "gradleTest": ":core-lib:jvmTest",
      "areas": ["logic", "model", "domain", "math", "color", "palette", "match", "ports"]
    }
  ],
  "verify": ["./gradlew", "ktfmtCheck", ":detekt-rules:test", "detekt", ":core-lib:jvmTest", ":core-lib:testDebugUnitTest", ":core-lib:compileKotlinIosSimulatorArm64", "-Pkotlin.native.enableKlibsCrossCompilation=true"]
}
